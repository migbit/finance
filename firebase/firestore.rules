rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isFilipa() {
      return signedIn() && request.auth.uid == 'SsNolBpIOxQK1upboCXIUwWlsuV2';
    }

    function isFrancisca() {
      return signedIn() && request.auth.uid == 'Fg8GKPt6fNb1vXIZf3Eg0xsHQID3';
    }

    function isLeonor() {
      return signedIn() && request.auth.uid == '9d2FHATsREVrX2t5gJDBviNWibv1';
    }

    function isFamilyChild() {
      return isFrancisca() || isLeonor();
    }

    // Para compatibilidade com a aplicação pessoal existente, qualquer conta
    // autenticada que não seja uma das duas crianças mantém o papel parental.
    function isFamilyParent() {
      return signedIn() && !isFamilyChild();
    }

    function ownsFamilyAccount(childId) {
      return (childId == 'francisca' && isFrancisca())
        || (childId == 'leonor' && isLeonor());
    }

    function canReadFamilyAccount(childId) {
      return isFamilyParent() || ownsFamilyAccount(childId);
    }

    function investmentsReleased() {
      return request.time >= timestamp.date(2027, 12, 21);
    }

    function canReadInvestments() {
      return signedIn() && !isFamilyChild() && (!isFilipa() || investmentsReleased());
    }

    function canWriteInvestments() {
      return signedIn() && !isFamilyChild() && !isFilipa();
    }

    match /alojamento_boletins/{token} {
      allow get: if true;
      allow list, create, update, delete: if signedIn() && !isFilipa() && !isFamilyChild();

      match /guests/{guestId} {
        allow read: if (signedIn() && !isFilipa() && !isFamilyChild())
          || exists(/databases/$(database)/documents/alojamento_boletins/$(token));
        allow update, delete: if signedIn() && !isFilipa() && !isFamilyChild();
        allow create: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))
          && request.resource.data.keys().hasOnly([
            'firstName',
            'lastName',
            'birthDate',
            'documentType',
            'documentNumber',
            'countryOrigin',
            'countryResidence',
            'documentCountry',
            'checkinDate',
            'checkoutDate',
            'declarationAccepted',
            'submittedAt',
            'userAgent'
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.birthDate is string
          && request.resource.data.documentType in ['passport', 'id', 'other']
          && request.resource.data.documentNumber is string
          && request.resource.data.countryOrigin is string
          && request.resource.data.countryResidence is string
          && request.resource.data.documentCountry is string
          && request.resource.data.checkinDate is string
          && request.resource.data.checkoutDate is string
          && request.resource.data.declarationAccepted == true;
        allow update: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'birthDate',
            'documentType',
            'documentNumber',
            'countryOrigin',
            'countryResidence',
            'documentCountry',
            'declarationAccepted',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'firstName',
            'lastName',
            'birthDate',
            'documentType',
            'documentNumber',
            'countryOrigin',
            'countryResidence',
            'documentCountry',
            'checkinDate',
            'checkoutDate',
            'declarationAccepted',
            'submittedAt',
            'updatedAt',
            'userAgent',
            'createdByAdmin'
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.birthDate is string
          && request.resource.data.documentType in ['passport', 'id', 'other']
          && request.resource.data.documentNumber is string
          && request.resource.data.countryOrigin is string
          && request.resource.data.countryResidence is string
          && request.resource.data.documentCountry is string
          && request.resource.data.declarationAccepted == true
          && request.resource.data.updatedAt is timestamp;
      }

      match /guest_summaries/{summaryId} {
        allow read: if true;
        allow update, delete: if signedIn() && !isFilipa() && !isFamilyChild();
        allow create: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))
          && request.resource.data.keys().hasOnly([
            'firstName',
            'lastName',
            'submittedAt'
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.firstName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.firstName
          && request.resource.data.lastName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.lastName;
        allow update: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName'
          ])
          && request.resource.data.keys().hasOnly([
            'firstName',
            'lastName',
            'submittedAt'
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.firstName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.firstName
          && request.resource.data.lastName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.lastName;
      }
    }

    // Áreas explicitamente autorizadas à Filipa.
    match /obras_checklists/{document=**} {
      allow read, write: if signedIn() && !isFamilyChild();
    }

    match /listas_compras/{document=**} {
      allow read, write: if signedIn() && !isFamilyChild();
    }

    match /comments/{document=**} {
      allow read, write: if signedIn() && !isFamilyChild();
    }

    match /reparacoes/{document=**} {
      allow read, write: if signedIn() && !isFamilyChild();
    }

    match /alimentacao_perfis/{userId} {
      allow read, write: if signedIn()
        && ((!isFilipa() && !isFamilyChild()) || request.auth.uid == userId);
    }

    // Dados pessoais dos módulos colocados nas áreas individuais.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn()
        && ((!isFilipa() && !isFamilyChild()) || request.auth.uid == userId);
    }

    // Finanças familiares: os clientes só leem dados autorizados. Todos os
    // pedidos, saldos, movimentos, investimentos e decisões passam pelas
    // Functions, que validam identidade, regras de negócio e auditoria.
    match /family_finance_accounts/{childId} {
      allow read: if canReadFamilyAccount(childId);
      allow create, update, delete: if false;

      match /requests/{requestId} {
        allow read: if isFamilyParent()
          || (ownsFamilyAccount(childId)
            && (resource.data.status != 'rejected'
              || (resource.data.visibleToChildUntil is timestamp
                && resource.data.visibleToChildUntil > request.time)));
        allow create, update, delete: if false;
      }

      match /ledger/{entryId} {
        allow read: if canReadFamilyAccount(childId);
        allow write: if false;
      }

      match /vaults/{vaultId} {
        allow read: if canReadFamilyAccount(childId);
        allow write: if false;
      }

      match /positions/{positionId} {
        allow read: if canReadFamilyAccount(childId);
        allow write: if false;
      }

      match /goals/{goalId} {
        allow read: if canReadFamilyAccount(childId);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /family_finance_quotes/{instrumentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /family_finance_quote_history/{historyId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /family_finance_meta/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /family_finance_audit/{eventId} {
      allow read: if isFamilyParent();
      allow write: if false;
    }

    // Investimentos: a Filipa só pode ler a partir de 21/12/2027.
    match /dca/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_settings/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_juro/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_juro_movements/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_monthly_closures/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_revolut/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_revolut_settings/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_manual/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_meta/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_investments/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_monthly_totals/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_apy/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_deallocate/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_monthly_assets/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    // Tudo o que não foi autorizado acima fica negado à Filipa. Isto faz com
    // que módulos e coleções futuros exijam uma autorização explícita.
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && !isFilipa()
        && !isFamilyChild()
        && !(collection in [
          'family_finance_accounts',
          'family_finance_quotes',
          'family_finance_quote_history',
          'family_finance_meta',
          'family_finance_audit'
        ]);
    }
  }
}
