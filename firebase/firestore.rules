rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isFilipa() {
      return signedIn() && request.auth.uid == 'SsNolBpIOxQK1upboCXIUwWlsuV2';
    }

    function isFrancisca() {
      return signedIn() && request.auth.uid == 'Fg8GKPt6fNb1vXIZf3Eg0xsHQID3';
    }

    function isLeonor() {
      return signedIn() && request.auth.uid == '9d2FHATsREVrX2t5gJDBviNWibv1';
    }

    function isFamilyChild() {
      return isFrancisca() || isLeonor();
    }

    // Para compatibilidade com a aplicação pessoal existente, qualquer conta
    // autenticada que não seja uma das duas crianças mantém o papel parental.
    function isFamilyParent() {
      return signedIn() && !isFamilyChild();
    }

    function ownsFamilyAccount(childId) {
      return (childId == 'francisca' && isFrancisca())
        || (childId == 'leonor' && isLeonor());
    }

    function canReadFamilyAccount(childId) {
      return isFamilyParent() || ownsFamilyAccount(childId);
    }

    function canManageSchoolCalendar(childId) {
      return signedIn() && childId == 'francisca';
    }

    function validSchoolTest(childId) {
      return request.resource.data.keys().hasAll([
          'childId',
          'subject',
          'testDate',
          'description',
          'notes',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'childId',
          'subject',
          'testDate',
          'description',
          'notes',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.childId == childId
        && request.resource.data.subject in [
          'Matemática',
          'Português',
          'História e Geografia de Portugal',
          'Educação Visual',
          'Ciências Naturais',
          'Inglês',
          'Cidadania e Desenvolvimento',
          'Técnicas de Dança',
          'Expressão Criativa',
          'Música'
        ]
        && request.resource.data.testDate is string
        && request.resource.data.testDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 120
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && (!request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['updatedBy'])
          || request.resource.data.updatedBy is string);
    }

    function investmentsReleased() {
      return request.time >= timestamp.date(2027, 12, 21);
    }

    function canReadInvestments() {
      return signedIn() && !isFamilyChild() && (!isFilipa() || investmentsReleased());
    }

    function canWriteInvestments() {
      return signedIn() && !isFamilyChild() && !isFilipa();
    }

    function validDcaAutomation() {
      return request.resource.data.enabled is bool
        && request.resource.data.effectiveFrom is string
        && request.resource.data.effectiveFrom.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.vwceAmountCents is int
        && request.resource.data.agghAmountCents is int
        && request.resource.data.vwceAmountCents >= 0
        && request.resource.data.agghAmountCents >= 0
        && request.resource.data.vwceAmountCents + request.resource.data.agghAmountCents > 0
        && request.resource.data.annualInterestRate is number
        && request.resource.data.annualInterestRate >= 0
        && request.resource.data.annualInterestRate <= 1
        && request.resource.data.timezone == 'Europe/Lisbon'
        && request.resource.data.day == 1
        && request.resource.data.time == '01:10';
    }

    function validDcaReinforcement() {
      return request.resource.data.id is string
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.totalAmountCents is int
        && request.resource.data.vwceAmountCents is int
        && request.resource.data.agghAmountCents is int
        && request.resource.data.vwcePriceMicros is int
        && request.resource.data.agghPriceMicros is int
        && request.resource.data.totalAmountCents > 0
        && request.resource.data.vwceAmountCents >= 0
        && request.resource.data.agghAmountCents >= 0
        && request.resource.data.vwceAmountCents + request.resource.data.agghAmountCents == request.resource.data.totalAmountCents
        && request.resource.data.vwceQuantity is number
        && request.resource.data.agghQuantity is number
        && request.resource.data.totalAmount is number
        && request.resource.data.vwceAmount is number
        && request.resource.data.agghAmount is number
        && request.resource.data.vwcePrice is number
        && request.resource.data.agghPrice is number
        && request.resource.data.totalAmount > 0
        && request.resource.data.vwceAmount >= 0
        && request.resource.data.agghAmount >= 0
        && request.resource.data.vwcePrice > 0
        && request.resource.data.agghPrice > 0
        && request.resource.data.vwcePriceMicros > 0
        && request.resource.data.agghPriceMicros > 0
        && request.resource.data.vwceQuantity >= 0
        && request.resource.data.agghQuantity >= 0
        && request.resource.data.status in ['active', 'void']
        && request.resource.data.fundingSource in ['trade_republic_balance', 'external_cash']
        && request.resource.data.allocationMode in ['automatic', 'manual_percentage', 'manual_amounts']
        && request.resource.data.quoteSource in ['alpha_vantage', 'manual']
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500;
    }

    match /alojamento_boletins/{token} {
      allow get: if true;
      allow list, create, update, delete: if signedIn() && !isFilipa() && !isFamilyChild();

      match /guests/{guestId} {
        allow read: if (signedIn() && !isFilipa() && !isFamilyChild())
          || exists(/databases/$(database)/documents/alojamento_boletins/$(token));
        allow update, delete: if signedIn() && !isFilipa() && !isFamilyChild();
        allow create: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))
          && request.resource.data.keys().hasOnly([
            'firstName',
            'lastName',
            'birthDate',
            'documentType',
            'documentNumber',
            'countryOrigin',
            'countryResidence',
            'documentCountry',
            'checkinDate',
            'checkoutDate',
            'declarationAccepted',
            'submittedAt',
            'userAgent'
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.birthDate is string
          && request.resource.data.documentType in ['passport', 'id', 'other']
          && request.resource.data.documentNumber is string
          && request.resource.data.countryOrigin is string
          && request.resource.data.countryResidence is string
          && request.resource.data.documentCountry is string
          && request.resource.data.checkinDate is string
          && request.resource.data.checkoutDate is string
          && request.resource.data.declarationAccepted == true;
        allow update: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'birthDate',
            'documentType',
            'documentNumber',
            'countryOrigin',
            'countryResidence',
            'documentCountry',
            'declarationAccepted',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'firstName',
            'lastName',
            'birthDate',
            'documentType',
            'documentNumber',
            'countryOrigin',
            'countryResidence',
            'documentCountry',
            'checkinDate',
            'checkoutDate',
            'declarationAccepted',
            'submittedAt',
            'updatedAt',
            'userAgent',
            'createdByAdmin'
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.birthDate is string
          && request.resource.data.documentType in ['passport', 'id', 'other']
          && request.resource.data.documentNumber is string
          && request.resource.data.countryOrigin is string
          && request.resource.data.countryResidence is string
          && request.resource.data.documentCountry is string
          && request.resource.data.declarationAccepted == true
          && request.resource.data.updatedAt is timestamp;
      }

      match /guest_summaries/{summaryId} {
        allow read: if true;
        allow update, delete: if signedIn() && !isFilipa() && !isFamilyChild();
        allow create: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))
          && request.resource.data.keys().hasOnly([
            'firstName',
            'lastName',
            'submittedAt'
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.firstName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.firstName
          && request.resource.data.lastName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.lastName;
        allow update: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName'
          ])
          && request.resource.data.keys().hasOnly([
            'firstName',
            'lastName',
            'submittedAt'
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.firstName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.firstName
          && request.resource.data.lastName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.lastName;
      }
    }

    // Áreas explicitamente autorizadas à Filipa.
    match /obras_checklists/{document=**} {
      allow read, write: if signedIn() && !isFamilyChild();
    }

    match /listas_compras/{document=**} {
      allow read, write: if signedIn() && !isFamilyChild();
    }

    match /comments/{document=**} {
      allow read, write: if signedIn() && !isFamilyChild();
    }

    match /reparacoes/{document=**} {
      allow read, write: if signedIn() && !isFamilyChild();
    }

    match /alimentacao_perfis/{userId} {
      allow read, write: if signedIn()
        && ((!isFilipa() && !isFamilyChild()) || request.auth.uid == userId);
    }

    // Dados pessoais dos módulos colocados nas áreas individuais.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn()
        && ((!isFilipa() && !isFamilyChild()) || request.auth.uid == userId);
    }

    // Finanças familiares: os clientes só leem dados autorizados. Todos os
    // pedidos, saldos, movimentos, investimentos e decisões passam pelas
    // Functions, que validam identidade, regras de negócio e auditoria.
    match /family_finance_accounts/{childId} {
      allow read: if canReadFamilyAccount(childId);
      allow create, update, delete: if false;

      match /requests/{requestId} {
        allow read: if isFamilyParent()
          || (ownsFamilyAccount(childId)
            && (resource.data.status != 'rejected'
              || (resource.data.visibleToChildUntil is timestamp
                && resource.data.visibleToChildUntil > request.time)));
        allow create, update, delete: if false;
      }

      match /ledger/{entryId} {
        allow read: if canReadFamilyAccount(childId);
        allow write: if false;
      }

      match /vaults/{vaultId} {
        allow read: if canReadFamilyAccount(childId);
        allow write: if false;
      }

      match /positions/{positionId} {
        allow read: if canReadFamilyAccount(childId);
        allow write: if false;
      }

      match /goals/{goalId} {
        allow read: if canReadFamilyAccount(childId);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /family_finance_quotes/{instrumentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /family_finance_quote_history/{historyId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /family_finance_meta/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /family_finance_audit/{eventId} {
      allow read: if isFamilyParent();
      allow write: if false;
    }

    // Agenda escolar da Francisca. Datas de testes são strings date-only para
    // que nunca mudem de dia por conversões de fuso horário.
    match /family_school_calendars/{childId} {
      allow read, write: if false;

      match /tests/{testId} {
        allow read: if canManageSchoolCalendar(childId);
        allow create: if canManageSchoolCalendar(childId)
          && validSchoolTest(childId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && !request.resource.data.keys().hasAny(['updatedAt', 'updatedBy']);
        allow update: if canManageSchoolCalendar(childId)
          && validSchoolTest(childId)
          && request.resource.data.childId == resource.data.childId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if canManageSchoolCalendar(childId);
      }
    }

    // Investimentos: a Filipa só pode ler a partir de 21/12/2027.
    match /dca/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_settings/{document} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments() && document != 'automation';
    }

    match /dca_settings/automation {
      allow read: if canReadInvestments();
      allow create, update: if canWriteInvestments()
        && request.resource.data.updatedAt == request.time
        && validDcaAutomation();
      allow delete: if false;
    }

    match /dca_juro/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_juro_movements/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_monthly_closures/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_reinforcements/{reinforcementId} {
      allow read: if canReadInvestments();
      allow create: if canWriteInvestments()
        && reinforcementId == request.resource.data.id
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validDcaReinforcement();
      allow update: if canWriteInvestments()
        && resource.data.id == request.resource.data.id
        && resource.data.status == 'active'
        && request.resource.data.status == 'void'
        && request.resource.data.voidedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'voidedAt', 'updatedAt'])
        && validDcaReinforcement();
      allow delete: if false;
    }

    match /dca_reconciliations/{document=**} {
      allow read, create: if canWriteInvestments();
      allow update, delete: if false;
    }

    match /dca_revolut/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /dca_revolut_settings/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_manual/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_meta/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_investments/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_monthly_totals/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_apy/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_deallocate/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    match /cryptoportfolio_monthly_assets/{document=**} {
      allow read: if canReadInvestments();
      allow write: if canWriteInvestments();
    }

    // Tudo o que não foi autorizado acima fica negado à Filipa. Isto faz com
    // que módulos e coleções futuros exijam uma autorização explícita.
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && !isFilipa()
        && !isFamilyChild()
        && !(collection in [
          'family_finance_accounts',
          'family_finance_quotes',
          'family_finance_quote_history',
          'family_finance_meta',
          'family_finance_audit',
          'family_school_calendars'
        ]);
    }
  }
}
