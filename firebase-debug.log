[debug] [2026-08-30T08:21:05.616Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/apartments-a4b17/rulesets {"name":"projects/apartments-a4b17/rulesets/3de1ce04-95c6-4aef-8975-3e35041abc9c","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isFilipa() {\n      return signedIn() && request.auth.uid == 'SsNolBpIOxQK1upboCXIUwWlsuV2';\n    }\n\n    function isFrancisca() {\n      return signedIn() && request.auth.uid == 'Fg8GKPt6fNb1vXIZf3Eg0xsHQID3';\n    }\n\n    function isLeonor() {\n      return signedIn() && request.auth.uid == '9d2FHATsREVrX2t5gJDBviNWibv1';\n    }\n\n    function isFamilyChild() {\n      return isFrancisca() || isLeonor();\n    }\n\n    // Para compatibilidade com a aplicação pessoal existente, qualquer conta\n    // autenticada que não seja uma das duas crianças mantém o papel parental.\n    function isFamilyParent() {\n      return signedIn() && !isFamilyChild();\n    }\n\n    function ownsFamilyAccount(childId) {\n      return (childId == 'francisca' && isFrancisca())\n        || (childId == 'leonor' && isLeonor());\n    }\n\n    function canReadFamilyAccount(childId) {\n      return isFamilyParent() || ownsFamilyAccount(childId);\n    }\n\n    function investmentsReleased() {\n      return request.time >= timestamp.date(2027, 12, 21);\n    }\n\n    function canReadInvestments() {\n      return signedIn() && !isFamilyChild() && (!isFilipa() || investmentsReleased());\n    }\n\n    function canWriteInvestments() {\n      return signedIn() && !isFamilyChild() && !isFilipa();\n    }\n\n    match /alojamento_boletins/{token} {\n      allow get: if true;\n      allow list, create, update, delete: if signedIn() && !isFilipa() && !isFamilyChild();\n\n      match /guests/{guestId} {\n        allow read: if (signedIn() && !isFilipa() && !isFamilyChild())\n          || exists(/databases/$(database)/documents/alojamento_boletins/$(token));\n        allow update, delete: if signedIn() && !isFilipa() && !isFamilyChild();\n        allow create: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))\n          && request.resource.data.keys().hasOnly([\n            'firstName',\n            'lastName',\n            'birthDate',\n            'documentType',\n            'documentNumber',\n            'countryOrigin',\n            'countryResidence',\n            'documentCountry',\n            'checkinDate',\n            'checkoutDate',\n            'declarationAccepted',\n            'submittedAt',\n            'userAgent'\n          ])\n          && request.resource.data.firstName is string\n          && request.resource.data.lastName is string\n          && request.resource.data.birthDate is string\n          && request.resource.data.documentType in ['passport', 'id', 'other']\n          && request.resource.data.documentNumber is string\n          && request.resource.data.countryOrigin is string\n          && request.resource.data.countryResidence is string\n          && request.resource.data.documentCountry is string\n          && request.resource.data.checkinDate is string\n          && request.resource.data.checkoutDate is string\n          && request.resource.data.declarationAccepted == true;\n        allow update: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'firstName',\n            'lastName',\n            'birthDate',\n            'documentType',\n            'documentNumber',\n            'countryOrigin',\n            'countryResidence',\n            'documentCountry',\n            'declarationAccepted',\n            'updatedAt'\n          ])\n          && request.resource.data.keys().hasOnly([\n            'firstName',\n            'lastName',\n            'birthDate',\n            'documentType',\n            'documentNumber',\n            'countryOrigin',\n            'countryResidence',\n            'documentCountry',\n            'checkinDate',\n            'checkoutDate',\n            'declarationAccepted',\n            'submittedAt',\n            'updatedAt',\n            'userAgent',\n            'createdByAdmin'\n          ])\n          && request.resource.data.firstName is string\n          && request.resource.data.lastName is string\n          && request.resource.data.birthDate is string\n          && request.resource.data.documentType in ['passport', 'id', 'other']\n          && request.resource.data.documentNumber is string\n          && request.resource.data.countryOrigin is string\n          && request.resource.data.countryResidence is string\n          && request.resource.data.documentCountry is string\n          && request.resource.data.declarationAccepted == true\n          && request.resource.data.updatedAt is timestamp;\n      }\n\n      match /guest_summaries/{summaryId} {\n        allow read: if true;\n        allow update, delete: if signedIn() && !isFilipa() && !isFamilyChild();\n        allow create: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))\n          && request.resource.data.keys().hasOnly([\n            'firstName',\n            'lastName',\n            'submittedAt'\n          ])\n          && request.resource.data.firstName is string\n          && request.resource.data.lastName is string\n          && request.resource.data.firstName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.firstName\n          && request.resource.data.lastName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.lastName;\n        allow update: if exists(/databases/$(database)/documents/alojamento_boletins/$(token))\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'firstName',\n            'lastName'\n          ])\n          && request.resource.data.keys().hasOnly([\n            'firstName',\n            'lastName',\n            'submittedAt'\n          ])\n          && request.resource.data.firstName is string\n          && request.resource.data.lastName is string\n          && request.resource.data.firstName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.firstName\n          && request.resource.data.lastName == getAfter(/databases/$(database)/documents/alojamento_boletins/$(token)/guests/$(summaryId)).data.lastName;\n      }\n    }\n\n    // Áreas explicitamente autorizadas à Filipa.\n    match /obras_checklists/{document=**} {\n      allow read, write: if signedIn() && !isFamilyChild();\n    }\n\n    match /listas_compras/{document=**} {\n      allow read, write: if signedIn() && !isFamilyChild();\n    }\n\n    match /comments/{document=**} {\n      allow read, write: if signedIn() && !isFamilyChild();\n    }\n\n    match /reparacoes/{document=**} {\n      allow read, write: if signedIn() && !isFamilyChild();\n    }\n\n    match /alimentacao_perfis/{userId} {\n      allow read, write: if signedIn()\n        && ((!isFilipa() && !isFamilyChild()) || request.auth.uid == userId);\n    }\n\n    // Dados pessoais dos módulos colocados nas áreas individuais.\n    match /users/{userId}/{document=**} {\n      allow read, write: if signedIn()\n        && ((!isFilipa() && !isFamilyChild()) || request.auth.uid == userId);\n    }\n\n    // Finanças familiares: os clientes só leem dados autorizados. Todos os\n    // pedidos, saldos, movimentos, investimentos e decisões passam pelas\n    // Functions, que validam identidade, regras de negócio e auditoria.\n    match /family_finance_accounts/{childId} {\n      allow read: if canReadFamilyAccount(childId);\n      allow create, update, delete: if false;\n\n      match /requests/{requestId} {\n        allow read: if isFamilyParent()\n          || (ownsFamilyAccount(childId)\n            && (resource.data.status != 'rejected'\n              || (resource.data.visibleToChildUntil is timestamp\n                && resource.data.visibleToChildUntil > request.time)));\n        allow create, update, delete: if false;\n      }\n\n      match /ledger/{entryId} {\n        allow read: if canReadFamilyAccount(childId);\n        allow write: if false;\n      }\n\n      match /vaults/{vaultId} {\n        allow read: if canReadFamilyAccount(childId);\n        allow write: if false;\n      }\n\n      match /positions/{positionId} {\n        allow read: if canReadFamilyAccount(childId);\n        allow write: if false;\n      }\n\n      match /goals/{goalId} {\n        allow read: if canReadFamilyAccount(childId);\n        allow write: if false;\n      }\n\n      match /{document=**} {\n        allow read, write: if false;\n      }\n    }\n\n    match /family_finance_quotes/{instrumentId} {\n      allow read: if signedIn();\n      allow write: if false;\n    }\n\n    match /family_finance_quote_history/{historyId} {\n      allow read: if signedIn();\n      allow write: if false;\n    }\n\n    match /family_finance_meta/{documentId} {\n      allow read: if signedIn();\n      allow write: if false;\n    }\n\n    match /family_finance_audit/{eventId} {\n      allow read: if isFamilyParent();\n      allow write: if false;\n    }\n\n    // Investimentos: a Filipa só pode ler a partir de 21/12/2027.\n    match /dca/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /dca_settings/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /dca_juro/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /dca_juro_movements/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /dca_monthly_closures/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /dca_revolut/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /dca_revolut_settings/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /cryptoportfolio/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /cryptoportfolio_manual/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /cryptoportfolio_meta/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /cryptoportfolio_investments/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /cryptoportfolio_monthly_totals/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /cryptoportfolio_apy/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /cryptoportfolio_deallocate/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    match /cryptoportfolio_monthly_assets/{document=**} {\n      allow read: if canReadInvestments();\n      allow write: if canWriteInvestments();\n    }\n\n    // Tudo o que não foi autorizado acima fica negado à Filipa. Isto faz com\n    // que módulos e coleções futuros exijam uma autorização explícita.\n    match /{collection}/{document=**} {\n      allow read, write: if signedIn()\n        && !isFilipa()\n        && !isFamilyChild()\n        && !(collection in [\n          'family_finance_accounts',\n          'family_finance_quotes',\n          'family_finance_quote_history',\n          'family_finance_meta',\n          'family_finance_audit'\n        ]);\n    }\n  }\n}\n","name":"firebase/firestore.rules"}]},"createTime":"2026-08-30T08:21:05.202943Z","metadata":{"services":["cloud.firestore"]}}
