{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "functions": {
    "source": "firebase/functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firebase/**",
      ".firebase/**",
      ".claude/**",
      ".agents/**",
      ".codex",
      ".codex/**",
      "firebase-debug.log",
      "**/*-debug.log",
      ".git/**",
      "node_modules/**",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "tests/**"
    ],
    "headers": [
      { "source": "/modules/boletim.html", "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ] }
    ],
    "rewrites": [
      {
        "source": "/api/guest-registration",
        "function": { "functionId": "guestRegistration", "region": "europe-west1" }
      },
      {
        "source": "/api/family-finance/quotes",
        "function": {
          "functionId": "familyFinanceQuotes",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/family-finance",
        "function": {
          "functionId": "familyFinance",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/portfolio",
        "function": {
          "functionId": "krakenPortfolio",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/crypto/prices",
        "function": {
          "functionId": "cryptoPrices",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/cleaning-hours",
        "function": {
          "functionId": "cleaningHours",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/cleaning-calendar",
        "function": {
          "functionId": "cleaningCalendar",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/cleaning-alerts",
        "function": {
          "functionId": "cleaningAlerts",
          "region": "europe-west1"
        }
      }
    ]
  }
}
